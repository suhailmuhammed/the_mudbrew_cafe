# MudBrew Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Staff Admin Authentication (generate a secure random 64-char string for production)
JWT_SECRET=your_jwt_secret_token_here_change_in_production

# Default Admin Credentials for Initial Database Seeding
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=your_strong_admin_password_here

# Optional: Email Notification Gateway (SMTP)
# Leave blank if unconfigured; the system will honestly indicate unconfigured status
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The MudBrew Concierge <hello@themudbrewcafe.com>"

# Optional: WhatsApp Business Cloud API Integration
# Leave blank if unconfigured; the system will honestly indicate unconfigured status
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

